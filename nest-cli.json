{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.hbs",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/assets/*",
      "src/notifications/assets/*"
    ]
  },
  "generateOptions": {
    "spec": false
  }
}